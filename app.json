{
  "expo": {
    "name": "Bait Al Hana",
    "slug": "bait-al-hana-customer",
    "scheme": "baitalhana",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.baitalhana.customer",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.baitalhana.customer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "config": {
        "googleMaps": {
          "//": "Supply your Google Maps Android API key here (or via EAS secret). Never commit a real key.",
          "apiKey": ""
        }
      }
    },
    "plugins": [
      [
        "expo-location",
        { "locationWhenInUsePermission": "Allow Bait Al Hana to use your location to set your delivery address." }
      ]
    ],
    "extra": {
      "//": "API base URL is injected per environment; never hard-code secrets.",
      "apiBaseUrl": "https://bah-api-453110822953.me-central1.run.app/api/v1",
      "googleMapsApiKey": ""
    }
  }
}
